Data_retrieval_skill_project/
# Explicit so the notes stay private even if the parent rule is ever narrowed
Data_retrieval_skill_project/MDs/
*.ai
Smart Water/

# ---- Office temp / backup / OneDrive conflict copies ----
~$*
*AutoRecovered*
*Repaired*
*.BACKUP-*
* copy.*
DEL_*
*_DEL.*
*_del.*
*-DESKTOP-*

# ---- Conversation DB snapshots / merge sources and the merge script (local tooling) ----
WebUI/conversation_DBs/

