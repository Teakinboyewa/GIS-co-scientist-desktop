/results*.json
/aoi_bbox.json
/candidate_summary.json
/search_payload.json
/*.xlsx
/*.ipynb

# ---- Not part of the app: standalone eval tooling, the separate Smart Water UI, one-off scripts ----
/eval/
/WebUI_revamped/
.claude/
WebUI/backfill_conversation_modes.py
WebUI/export_offline_conversation.py
WebUI/render_conversation_html.py

# ---- Superseded versions, old manuals, scratch, sample demo data ----
*.tar.gz
WebUI/*_v[0-9].py
WebUI/*_v[0-9].js
WebUI/user_manual*.html
agents/user_manual.*
agents/modeling_agent/model_base/curated_model_kb_v1.py
agents/modeling_agent/test_modeling_agent.py
agents/task_manager/solution_graph.html
utils/rough.py
agents/data_agent/*.gpkg
agents/data_agent/*.csv
agents/data_agent/USDA_ERS_Geospatial_v1.toml

# React source for /home and /map-interpreter (built output in WebUI/ui/ is kept)
WebUI/frontend/node_modules/

# Benchmark run records (per-run logs; agent outputs live in Outputs/)
benchmark/runs/

# Desktop app (generated locally)
desktop/deps/
desktop/profile/
desktop/logs/
*.lnk
build/
dist/
desktop/tools/

# ---- Desktop repo (public): keep out of git ----
# The shared data-source catalog is its own repo (Teakinboyewa/GIS-co-scientist-catalog).
catalog_repo/
# Mac build output and staging (desktop/build/build_mac.py)
*.dmg
build/mac_stage/

# Personal notes (paths, session IDs) kept on this computer only
README_LOCAL.md

# The "build/" rule above is for build output; the build *scripts* live in
# desktop/build/ and must be committed (the Mac workflow runs them).
!/desktop/build/
/desktop/build/__pycache__/
